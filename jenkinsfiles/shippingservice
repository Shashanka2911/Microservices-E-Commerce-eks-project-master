pipeline {
    agent any 

    environment {
        // Git Variables
        GIT_REPO_NAME = "Microservices-E-Commerce-eks-project-master"
        GIT_EMAIL = "shashankas2911@gmail.com"
        GIT_USER_NAME = "Shashanka2911" 
        
        // AWS and ECR Variables
        AWS_REGION = "ap-south-1"
        AWS_ACCOUNT_ID = "090587344627" 
        
        // UPDATED FOR SHIPPING SERVICE
        IMAGE_NAME = "shippingservice"
        REPO_URL = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}"
        YAML_FILE = "shippingservice.yaml"
    }

    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"
            }
        }

        stage("Docker Image Build") {
            steps {
                script {
                    dir("src/${IMAGE_NAME}") {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t $IMAGE_NAME .'
                    }
                }
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                    sh '''
                    aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                    docker tag $IMAGE_NAME:latest $REPO_URL:$BUILD_NUMBER
                    docker push $REPO_URL:$BUILD_NUMBER
                    '''
                }
            }
        }

        stage('Update Deployment file') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'my-git-pattoken', variable: 'git_token')]) {
                        sh '''
                            git config user.email "$GIT_EMAIL"
                            git config user.name "$GIT_USER_NAME"
                            echo $BUILD_NUMBER

                            sed -i "s#image:.*#image: $REPO_URL:$BUILD_NUMBER#g" $YAML_FILE
                            git add .
                            git commit -m "Update $IMAGE_NAME Image to version $BUILD_NUMBER"
                            
                            git pull https://${git_token}@github.com/$GIT_USER_NAME/${GIT_REPO_NAME}.git main --rebase
                            
                            git push https://${git_token}@github.com/$GIT_USER_NAME/${GIT_REPO_NAME}.git HEAD:main
                        '''
                    }
                }
            }
        }
    }
}